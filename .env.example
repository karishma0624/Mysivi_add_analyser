# ==============================================================================
# MySivi Ad Intelligence Platform — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (frontend/.env.local)
# Used by React + Vite in the browser. Only public, anon keys belong here.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# ------------------------------------------------------------------------------
# 2. SUPABASE EDGE FUNCTION SECRETS (supabase/functions/chat/.env)
# Set via: supabase secrets set GEMINI_API_KEY=... SUPABASE_SERVICE_ROLE_KEY=...
# NEVER expose GEMINI_API_KEY or SERVICE_ROLE_KEY to frontend code.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...your-google-ai-studio-api-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------------------------
# 3. N8N AUTOMATION PIPELINE (Configured in n8n credentials or container env)
# Used by n8n workflow nodes to run Apify scraping, Gemini scoring, & Supabase upserts.
# ------------------------------------------------------------------------------
APIFY_API_TOKEN=apify_api_...your-apify-platform-token
# n8n also utilizes the same GEMINI_API_KEY, SUPABASE_URL, and SUPABASE_SERVICE_ROLE_KEY as above.
